{
  "schemaVersion": 1,
  "skillName": "ppt-planner-maker",
  "description": "外部制作 Skill 清单。编排层只引用 id，不写物理路径；路径由 resolve_skills.py 解析。",
  "installRootHint": "setup.py 默认安装到私有根 ~/.ppt-planner/skills（PPT_PLANNER_HOME 可覆盖，宿主不扫描，只暴露编排层）；手动安装时 <skills-dir> 可用该目录或解析顺序中的任一根目录。",
  "skills": [
    {
      "id": "ppt-master",
      "title": "PPTX 引擎：公司模板 / 自由设计 / 原生编辑 / 美化",
      "source": "https://github.com/xztsummer/ppt-master",
      "sourceNote": "定期同步 hugohe3/ppt-master 的定制 fork（当前 v6.8.0），自带中国电子云、中国电信、中汽研 deck；分支 A 选择已安装 deck 时要求至少一个可用 deck。用户自带 .pptx/.potx 公司模板文件时，预检显式加 --company-template-file，不要求预装 deck。",
      "license": "MIT",
      "testedVersion": "bc72031ab1e28ee882c452ca67f2b1e9280d197a（fork main，同步上游 v6.8.0，2026-11-06）",
      "branches": ["A", "B", "F"],
      "capabilities": {
        "skill": { "path": "SKILL.md", "required": true },
        "routing": { "path": "workflows/routing.md", "required": true },
        "scripts": { "path": "scripts", "required": true },
        "requirements": { "path": "requirements.txt", "required": true },
        "decks": {
          "path": "templates/decks",
          "required": false,
          "for": ["A"],
          "requireAnyChild": true,
          "childPath": "templates/design_spec.md"
        },
        "deck-index": {
          "path": "templates/decks/decks_index.json",
          "required": false,
          "for": ["A"]
        }
      },
      "runtime": {
        "python": ["yaml", "pptx", "xlsxwriter", "pathops", "uharfbuzz"],
        "optionalPython": ["edge_tts", "fitz"],
        "optionalCommands": ["soffice"],
        "install": "python -m pip install -r <ppt-master>/requirements.txt",
        "note": "soffice 只用于 .ppt 转换与视觉预览；不在 PATH 时脚本会尝试常见安装路径。edge-tts / PyMuPDF 为可选能力。skia-pathops 在过新的 Python 上可能缺少可用 wheel，建议改用带 wheel 的 Python（如 3.11/3.12）。"
      },
      "install": {
        "type": "git",
        "url": "https://github.com/xztsummer/ppt-master.git",
        "targetName": "ppt-master"
      },
      "testedRelease": "6.8.0"
    },
    {
      "id": "gorden-ppt-skill",
      "title": "中文内置模板 PPTX（复杂豪华）",
      "source": "https://github.com/GordenSun/GordenPPTSkill",
      "sourceNote": "内置模板与预览素材为非商业许可，见其 NOTICE.md；代码为 MIT。复杂豪华由内置模板（模式 A）兑现；原创模式 C 仅做简洁版式，不能承接复杂豪华。",
      "license": "MIT（代码）/ 非商业（内置模板）",
      "testedVersion": "1.0.20（7d4a61cbd8363b92e4a30784f8ca460a0a2b0a33，2026-06-22）",
      "branches": ["C"],
      "capabilities": {
        "skill": { "path": "SKILL.md", "required": true },
        "manifest": { "path": "manifest.json", "required": true },
        "templates": { "path": "templates", "required": true },
        "template-index": { "path": "templates/INDEX.md", "required": true },
        "build-script": { "path": "scripts/build_pptx.py", "required": true },
        "version": { "path": "VERSION", "required": false }
      },
      "runtime": {
        "python": ["pptx"],
        "install": "python -m pip install python-pptx",
        "note": "编排层调用时不执行会改写安装的 scripts/apply_update.py，只跑只读的 scripts/check_update.py；有新版本先告知用户，同意后才更新。Windows 上把 python3 换成 python。"
      },
      "install": {
        "type": "git",
        "url": "https://github.com/GordenSun/GordenPPTSkill.git",
        "targetName": "gorden-ppt-skill"
      },
      "testedRelease": "1.0.20"
    },
    {
      "id": "html-ppt",
